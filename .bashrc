# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '
cd ~/

# Created by `pipx` on 2025-08-31 19:21:08
export PATH="$PATH:/home/maya/.local/bin"
export EDITOR=vim
export EDITOR=vim
