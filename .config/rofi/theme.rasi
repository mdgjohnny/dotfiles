* {
    bg:       #1a1b26ee;
    bg-alt:   #24283b;
    fg:       #a9b1d6;
    fg-alt:   #565f89;
    accent:   #7aa2f7;
    urgent:   #f7768e;

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 480;
    background-color: @bg;
    border: 2px;
    border-color: @bg-alt;
    border-radius: 12;
}

mainbox {
    padding: 12;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8;
    padding: 8 12;
    spacing: 8;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-alt;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    border: 0;
    spacing: 4;
    padding: 8 0 0 0;
}

element {
    padding: 8 12;
    border-radius: 6;
    spacing: 8;
}

element normal normal, element alternate normal {
    background-color: transparent;
}

element selected normal {
    background-color: @bg-alt;
    text-color: @accent;
}

element-icon {
    size: 24;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
}

element selected element-text {
    text-color: @accent;
}
